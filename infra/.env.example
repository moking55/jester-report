# Copy to infra/.env and replace every value. Generate secrets with:  openssl rand -hex 24
# infra/.env holds real secrets: never commit it.

# letters and digits only: it goes into a postgresql:// URL, where @ / : ? # would break it
POSTGRES_PASSWORD=change-me
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me-too
# shared by api and studio: lets the api trust the browser IP that Studio forwards (login rate limit)
JESTER_STUDIO_KEY=change-me

# optional
JESTER_API_PORT=8000
JESTER_API_WORKERS=2
JESTER_STUDIO_PORT=3000
# 1 only behind a reverse proxy that appends the browser IP to X-Forwarded-For
JESTER_TRUST_PROXY=0
# keep true in production (HTTPS); false only to try Studio over plain http
JESTER_COOKIE_SECURE=true
