# Copy to infra/.env and replace every value. Generate secrets with:  openssl rand -hex 24
# infra/.env holds real secrets: never commit it.

# letters and digits only: it goes into a postgresql:// URL, where @ / : ? # would break it
POSTGRES_PASSWORD=change-me
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me-too
# shared by api and studio: lets the api trust the browser IP that Studio forwards (login rate limit)
JESTER_STUDIO_KEY=change-me

# optional
JESTER_API_PORT=8000
JESTER_API_WORKERS=2
JESTER_STUDIO_PORT=3000
# set 1 behind a reverse proxy that appends the browser IP to X-Forwarded-For; with 0 the api sees
# every Studio login from one address, so failed logins lock a username out for the whole team
JESTER_TRUST_PROXY=0
# keep true in production (HTTPS); false only to try Studio over plain http
JESTER_COOKIE_SECURE=true

# MCP connector for claude.ai (optional, v1.13): uncomment COMPOSE_PROFILES to start it with the rest
# COMPOSE_PROFILES=mcp
# its own public HTTPS host on your reverse proxy, and where people open Studio to publish
JESTER_MCP_PUBLIC_URL=https://mcp.example.com
JESTER_STUDIO_PUBLIC_URL=https://jester.example.com
JESTER_MCP_PORT=8100
# header your proxy puts the browser IP in (its last entry is used); empty = every login counts from one address
JESTER_MCP_CLIENT_IP_HEADER=X-Forwarded-For
