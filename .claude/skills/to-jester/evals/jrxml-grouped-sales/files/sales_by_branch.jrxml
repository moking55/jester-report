<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" name="sales_by_branch" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
  <parameter name="P_FROM" class="java.util.Date"/>
  <parameter name="P_TO" class="java.util.Date"/>
  <parameter name="P_COMPANY" class="java.lang.String"/>
  <queryString><![CDATA[SELECT branch, doc_no, doc_date, customer, net_amount FROM sales WHERE doc_date BETWEEN $P{P_FROM} AND $P{P_TO} ORDER BY branch, doc_no]]></queryString>
  <field name="branch" class="java.lang.String"/>
  <field name="doc_no" class="java.lang.String"/>
  <field name="doc_date" class="java.util.Date"/>
  <field name="customer" class="java.lang.String"/>
  <field name="net_amount" class="java.math.BigDecimal"/>
  <variable name="BRANCH_TOTAL" class="java.math.BigDecimal" resetType="Group" resetGroup="branchGroup" calculation="Sum"><variableExpression><![CDATA[$F{net_amount}]]></variableExpression></variable>
  <variable name="BRANCH_COUNT" class="java.lang.Integer" resetType="Group" resetGroup="branchGroup" calculation="Count"><variableExpression><![CDATA[$F{doc_no}]]></variableExpression></variable>
  <variable name="GRAND_TOTAL" class="java.math.BigDecimal" calculation="Sum"><variableExpression><![CDATA[$F{net_amount}]]></variableExpression></variable>
  <group name="branchGroup">
    <groupExpression><![CDATA[$F{branch}]]></groupExpression>
    <groupHeader><band height="20"><textField><reportElement x="0" y="0" width="300" height="20"/><textFieldExpression><![CDATA["สาขา " + $F{branch}]]></textFieldExpression></textField></band></groupHeader>
    <groupFooter><band height="20">
      <textField><reportElement x="0" y="0" width="300" height="20"/><textFieldExpression><![CDATA["รวมสาขา " + $F{branch} + " (" + $V{BRANCH_COUNT} + " ใบ)"]]></textFieldExpression></textField>
      <textField pattern="#,##0.00"><reportElement x="455" y="0" width="100" height="20"/><textFieldExpression><![CDATA[$V{BRANCH_TOTAL}]]></textFieldExpression></textField>
    </band></groupFooter>
  </group>
  <title><band height="50">
    <textField><reportElement x="0" y="0" width="555" height="25"/><textFieldExpression><![CDATA[$P{P_COMPANY}]]></textFieldExpression></textField>
    <staticText><reportElement x="0" y="25" width="555" height="25"/><text><![CDATA[รายงานยอดขายแยกตามสาขา]]></text></staticText>
  </band></title>
  <columnHeader><band height="20">
    <staticText><reportElement x="0" y="0" width="100" height="20"/><text><![CDATA[เลขที่]]></text></staticText>
    <staticText><reportElement x="100" y="0" width="100" height="20"/><text><![CDATA[วันที่]]></text></staticText>
    <staticText><reportElement x="200" y="0" width="255" height="20"/><text><![CDATA[ลูกค้า]]></text></staticText>
    <staticText><reportElement x="455" y="0" width="100" height="20"/><text><![CDATA[ยอดสุทธิ]]></text></staticText>
  </band></columnHeader>
  <detail><band height="20">
    <textField><reportElement x="0" y="0" width="100" height="20"/><textFieldExpression><![CDATA[$F{doc_no}]]></textFieldExpression></textField>
    <textField pattern="dd/MM/yyyy"><reportElement x="100" y="0" width="100" height="20"/><textFieldExpression><![CDATA[$F{doc_date}]]></textFieldExpression></textField>
    <textField><reportElement x="200" y="0" width="255" height="20"/><textFieldExpression><![CDATA[$F{customer}]]></textFieldExpression></textField>
    <textField pattern="#,##0.00"><reportElement x="455" y="0" width="100" height="20"/><textFieldExpression><![CDATA[$F{net_amount}]]></textFieldExpression></textField>
  </band></detail>
  <pageFooter><band height="20"><textField><reportElement x="455" y="0" width="100" height="20"/><textFieldExpression><![CDATA["หน้า " + $V{PAGE_NUMBER}]]></textFieldExpression></textField></band></pageFooter>
  <summary><band height="20">
    <staticText><reportElement x="0" y="0" width="300" height="20"/><text><![CDATA[รวมทั้งสิ้น]]></text></staticText>
    <textField pattern="#,##0.00"><reportElement x="455" y="0" width="100" height="20"/><textFieldExpression><![CDATA[$V{GRAND_TOTAL}]]></textFieldExpression></textField>
  </summary>
</jasperReport>
